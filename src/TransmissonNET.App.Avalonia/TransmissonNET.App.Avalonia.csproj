<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TransmissonNET.App</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Version comes from the GitHub release tag in CI (APPIMAGE_VERSION);
         local/dev builds default to 0.0.0-dev. -->
    <Version Condition="'$(APPIMAGE_VERSION)' != ''">$(APPIMAGE_VERSION)</Version>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <InformationalVersion Condition="'$(APPIMAGE_VERSION)' != ''">$(APPIMAGE_VERSION)</InformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.0.0-dev</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\**" />
    <AvaloniaResource Include="Controls\**\*.axaml" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\transmission-net-tray.png" Link="transmission-net-tray.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\transmission-net.png" Link="transmission-net.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransmissonNET.Application\TransmissonNET.Application.csproj" />
    <ProjectReference Include="..\TransmissonNET.Desktop\TransmissonNET.Desktop.csproj" />
    <ProjectReference Include="..\TransmissonNET.Infrastructure\TransmissonNET.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransmissonNET.Providers.RuTracker\TransmissonNET.Providers.RuTracker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
      <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;PublishSingleFile;PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\TransmissonNET.Providers.LostFilm\TransmissonNET.Providers.LostFilm.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
      <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;PublishSingleFile;PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\TransmissonNET.Providers.Kinozal\TransmissonNET.Providers.Kinozal.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
      <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;PublishSingleFile;PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\TransmissonNET.Providers.Dummy\TransmissonNET.Providers.Dummy.csproj" Condition="'$(Configuration)' == 'Debug'">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
      <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;PublishSingleFile;PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <TorrentProviderProject Include="$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.RuTracker\TransmissonNET.Providers.RuTracker.csproj" />
    <TorrentProviderProject Include="$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.LostFilm\TransmissonNET.Providers.LostFilm.csproj" />
    <TorrentProviderProject Include="$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.Kinozal\TransmissonNET.Providers.Kinozal.csproj" />
    <TorrentProviderProject Include="$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.Dummy\TransmissonNET.Providers.Dummy.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- SDK always defines PublishDir (.../publish/); the running app loads providers from OutputPath. -->
  <Target Name="BuildAndCopyTorrentProviders" AfterTargets="Build;PrepareForRun">
    <PropertyGroup>
      <_ProvidersDest>$([System.IO.Path]::GetFullPath('$(OutputPath)providers'))</_ProvidersDest>
      <_ProvidersConfig>$(Configuration)</_ProvidersConfig>
      <_ProvidersConfig Condition="'$(_ProvidersConfig)' == ''">Debug</_ProvidersConfig>
      <_RuTrackerBin>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.RuTracker\bin\$(_ProvidersConfig)\net8.0'))</_RuTrackerBin>
      <_LostFilmBin>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.LostFilm\bin\$(_ProvidersConfig)\net8.0'))</_LostFilmBin>
      <_KinozalBin>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.Kinozal\bin\$(_ProvidersConfig)\net8.0'))</_KinozalBin>
      <_DummyBin>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.Dummy\bin\$(_ProvidersConfig)\net8.0'))</_DummyBin>
    </PropertyGroup>

    <Exec Command="dotnet restore &quot;%(TorrentProviderProject.Identity)&quot;" />
    <Exec Command="dotnet build &quot;%(TorrentProviderProject.Identity)&quot; -c $(_ProvidersConfig) -f net8.0 --no-restore -p:CopyLocalLockFileAssemblies=true -p:RuntimeIdentifier= -p:SelfContained=false" />

    <ItemGroup>
      <_ProviderBuilt Include="$(_RuTrackerBin)\TransmissonNET.Providers.RuTracker.dll" />
      <_ProviderBuilt Include="$(_RuTrackerBin)\HtmlAgilityPack.dll" />
      <_ProviderBuilt Include="$(_RuTrackerBin)\TransmissonNET.Providers.RuTracker.deps.json" />
      <_ProviderBuilt Include="$(_LostFilmBin)\TransmissonNET.Providers.LostFilm.dll" />
      <_ProviderBuilt Include="$(_LostFilmBin)\HtmlAgilityPack.dll" />
      <_ProviderBuilt Include="$(_LostFilmBin)\TransmissonNET.Providers.LostFilm.deps.json" />
      <_ProviderBuilt Include="$(_KinozalBin)\TransmissonNET.Providers.Kinozal.dll" />
      <_ProviderBuilt Include="$(_KinozalBin)\HtmlAgilityPack.dll" />
      <_ProviderBuilt Include="$(_KinozalBin)\TransmissonNET.Providers.Kinozal.deps.json" />
      <_ProviderBuilt Include="$(_DummyBin)\TransmissonNET.Providers.Dummy.dll" Condition="'$(_ProvidersConfig)' == 'Debug'" />
      <_ProviderBuiltExisting Include="@(_ProviderBuilt)" Condition="Exists('%(Identity)')" />
    </ItemGroup>

    <Error Text="Torrent provider DLLs missing after build ($(_RuTrackerBin))." Condition="!Exists('$(_RuTrackerBin)\TransmissonNET.Providers.RuTracker.dll')" />

    <MakeDir Directories="$(_ProvidersDest)" />
    <Copy SourceFiles="@(_ProviderBuiltExisting)" DestinationFolder="$(_ProvidersDest)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Copied @(_ProviderBuiltExisting-&gt;Count()) provider file(s) to $(_ProvidersDest)" />
  </Target>

  <Target Name="PublishCopyTorrentProviders" AfterTargets="Publish" DependsOnTargets="BuildAndCopyTorrentProviders">
    <PropertyGroup>
      <_PublishProvidersDest>$([System.IO.Path]::GetFullPath('$(PublishDir)providers'))</_PublishProvidersDest>
      <_BuildProvidersSrc>$([System.IO.Path]::GetFullPath('$(OutputPath)providers'))</_BuildProvidersSrc>
    </PropertyGroup>
    <ItemGroup>
      <_PublishProviderFiles Include="$(_BuildProvidersSrc)\*" />
    </ItemGroup>
    <MakeDir Directories="$(_PublishProvidersDest)" />
    <Copy SourceFiles="@(_PublishProviderFiles)" DestinationFolder="$(_PublishProvidersDest)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'@(_PublishProviderFiles)' != ''" />
    <Message Importance="high" Text="Copied provider file(s) to $(_PublishProvidersDest)" />
  </Target>
</Project>
