<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TransmissonNET.App</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\**" />
    <AvaloniaResource Include="Controls\**\*.axaml" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\transmission-net-tray.png" Link="transmission-net-tray.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\transmission-net.png" Link="transmission-net.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransmissonNET.Application\TransmissonNET.Application.csproj" />
    <ProjectReference Include="..\TransmissonNET.Desktop\TransmissonNET.Desktop.csproj" />
    <ProjectReference Include="..\TransmissonNET.Infrastructure\TransmissonNET.Infrastructure.csproj" />
    <ProjectReference Include="..\TransmissonNET.Providers.RuTracker\TransmissonNET.Providers.RuTracker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\TransmissonNET.Providers.LostFilm\TransmissonNET.Providers.LostFilm.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\TransmissonNET.Providers.Kinozal\TransmissonNET.Providers.Kinozal.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\TransmissonNET.Providers.Dummy\TransmissonNET.Providers.Dummy.csproj"
                      Condition="'$(Configuration)' == 'Debug'">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyTorrentProviders" AfterTargets="Build">
    <PropertyGroup>
      <_ProvidersOut>$([System.IO.Path]::GetFullPath('$(OutputPath)providers'))</_ProvidersOut>
      <_RuTrackerOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.RuTracker\bin\$(Configuration)\net8.0'))</_RuTrackerOut>
      <_LostFilmOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.LostFilm\bin\$(Configuration)\net8.0'))</_LostFilmOut>
      <_KinozalOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.Kinozal\bin\$(Configuration)\net8.0'))</_KinozalOut>
      <_DummyOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TransmissonNET.Providers.Dummy\bin\$(Configuration)\net8.0'))</_DummyOut>
    </PropertyGroup>
    <MakeDir Directories="$(_ProvidersOut)" />
    <ItemGroup>
      <_ProviderCopy Include="$(_RuTrackerOut)\TransmissonNET.Providers.RuTracker.dll" />
      <_ProviderCopy Include="$(_RuTrackerOut)\HtmlAgilityPack.dll" />
      <_ProviderCopy Include="$(_RuTrackerOut)\TransmissonNET.Providers.RuTracker.deps.json" />
      <_ProviderCopy Include="$(_LostFilmOut)\TransmissonNET.Providers.LostFilm.dll" />
      <_ProviderCopy Include="$(_LostFilmOut)\HtmlAgilityPack.dll" />
      <_ProviderCopy Include="$(_LostFilmOut)\TransmissonNET.Providers.LostFilm.deps.json" />
      <_ProviderCopy Include="$(_KinozalOut)\TransmissonNET.Providers.Kinozal.dll" />
      <_ProviderCopy Include="$(_KinozalOut)\HtmlAgilityPack.dll" />
      <_ProviderCopy Include="$(_KinozalOut)\TransmissonNET.Providers.Kinozal.deps.json" />
      <_ProviderCopy Include="$(_DummyOut)\TransmissonNET.Providers.Dummy.dll"
                     Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProviderCopy)" DestinationFolder="$(_ProvidersOut)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>
</Project>
