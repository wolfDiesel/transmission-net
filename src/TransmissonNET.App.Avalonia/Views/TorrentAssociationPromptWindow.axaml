<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TransmissonNET.App.Avalonia.Controls"
        x:Class="TransmissonNET.App.Avalonia.Views.TorrentAssociationPromptWindow"
        Width="460"
        Height="220"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Padding="16"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Classes="island" Padding="16">
    <StackPanel Spacing="12">
      <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <controls:AppButton x:Name="NoButton" Variant="Ghost" Click="OnNo" />
        <controls:AppButton x:Name="YesButton" Variant="Primary" Click="OnYes" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
