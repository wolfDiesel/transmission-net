<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransmissonNET.App.Avalonia.Views.AboutWindow"
        Width="420"
        Height="320"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Padding="24"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <Image Source="avares://TransmissonNET.App/Assets/transmission-net.png" Width="52" Height="52" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="TransmissionNET" FontWeight="SemiBold" FontSize="20" />
        <TextBlock Classes="text-muted" FontSize="12">Desktop client for Transmission RPC</TextBlock>
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16" />

    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="text-muted" Text="Version" Width="90" />
        <TextBlock Classes="accent-text" FontWeight="SemiBold" x:Name="VersionValue" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="text-muted" Text="Author" Width="90" />
        <TextBlock x:Name="AuthorValue" />
      </StackPanel>
      <TextBlock Classes="text-muted" TextWrapping="Wrap" x:Name="DescriptionValue" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button x:Name="CloseButton" MinWidth="90" Content="Close" Click="OnClose" />
    </StackPanel>
  </DockPanel>
</Window>