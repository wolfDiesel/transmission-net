<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TransmissonNET.App.Avalonia.Views"
        xmlns:controls="using:TransmissonNET.App.Avalonia.Controls"
        x:Class="TransmissonNET.App.Avalonia.Views.MoveTorrentDialog"
        Title="Move torrent"
        Width="480"
        Height="220"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Padding="16"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Classes="island" Padding="16">
    <StackPanel Spacing="12">
      <views:DownloadDirPicker x:Name="DestinationBox"
                               PlaceholderText="Destination folder" />
      <CheckBox x:Name="MoveDataCheck" Content="Move data files" IsChecked="True" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <controls:AppButton Variant="Ghost" Content="Cancel" Click="OnCancel" />
        <controls:AppButton Variant="Primary" Content="Move" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
