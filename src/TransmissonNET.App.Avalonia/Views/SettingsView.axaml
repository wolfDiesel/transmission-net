<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransmissonNET.App.Avalonia.ViewModels"
             xmlns:conv="using:TransmissonNET.App.Avalonia.Converters"
             x:Class="TransmissonNET.App.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
        <TextBlock Classes="text-muted" Text="{Binding PageSubtitle}" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="btn-primary"
              Content="{Binding SaveSettingsLabel}"
              Command="{Binding SaveCommand}"
              VerticalAlignment="Center" />
    </Grid>

    <Border Classes="island-inner" Padding="4">
      <TabControl>
        <TabItem Header="{Binding TabConnection}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="16" HorizontalAlignment="Stretch">
              <StackPanel Spacing="4">
                <TextBlock Classes="section-title" Text="{Binding ConnectionTitle}" />
                <TextBlock Classes="text-muted" Text="{Binding ConnectionSubtitle}" TextWrapping="Wrap" />
              </StackPanel>

              <TextBlock Classes="field-section" Text="{Binding SectionConnection}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="field-label" Text="{Binding HostLabel}" />
                  <TextBox Text="{Binding Host}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="field-label" Text="{Binding PortLabel}" />
                  <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{Binding RpcPathLabel}" />
                <TextBox Text="{Binding RpcPath}" />
              </StackPanel>

              <TextBlock Classes="field-section" Text="{Binding SectionAuth}" Margin="0,8,0,0" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="field-label" Text="{Binding UsernameLabel}" />
                  <TextBox Text="{Binding Username}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="field-label" Text="{Binding PasswordLabel}" />
                  <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="{Binding PasswordPlaceholder}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="text-muted" Text="{Binding PasswordHint}" FontSize="11" />

              <Button Classes="btn-ghost" Content="{Binding TestConnectionLabel}" Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding TabDaemon}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="16" HorizontalAlignment="Stretch">
              <StackPanel Spacing="4">
                <TextBlock Classes="section-title" Text="{Binding DaemonPreferencesTitle}" />
                <TextBlock Classes="text-muted" Text="{Binding DaemonPreferencesSubtitle}" TextWrapping="Wrap" />
              </StackPanel>

              <TextBlock Classes="field-section" Text="{Binding DaemonStorageTitle}" />
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{Binding DownloadDirLabel}" />
                <TextBox Text="{Binding DaemonDownloadDir}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{Binding IncompleteDirLabel}" />
                <TextBox Text="{Binding DaemonIncompleteDir}" />
              </StackPanel>
              <CheckBox Content="{Binding IncompleteDirEnabledLabel}" IsChecked="{Binding DaemonIncompleteDirEnabled}" />
              <CheckBox Content="{Binding TrashTorrentLabel}" IsChecked="{Binding DaemonTrashTorrent}" />

              <TextBlock Classes="field-section" Text="{Binding PeersTitle}" Margin="0,8,0,0" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="field-label" Text="{Binding GlobalPeerLimitLabel}" />
                  <NumericUpDown Value="{Binding DaemonPeerLimitGlobal}" Minimum="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="field-label" Text="{Binding PeerLimitPerTorrentLabel}" />
                  <NumericUpDown Value="{Binding DaemonPeerLimitPerTorrent}" Minimum="0" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="field-section" Text="{Binding SpeedLimitsTitle}" Margin="0,8,0,0" />
              <CheckBox Content="{Binding EnableDownloadLimitLabel}" IsChecked="{Binding DaemonDownloadLimitEnabled}" />
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{Binding DownloadLimitLabel}" />
                <NumericUpDown Value="{Binding DaemonDownloadLimit}" Minimum="0" />
              </StackPanel>
              <CheckBox Content="{Binding EnableUploadLimitLabel}" IsChecked="{Binding DaemonUploadLimitEnabled}" />
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{Binding UploadLimitLabel}" />
                <NumericUpDown Value="{Binding DaemonUploadLimit}" Minimum="0" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Classes="btn-ghost" Content="{Binding ReloadDaemonLabel}" Command="{Binding LoadDaemonSessionCommand}" />
                <Button Classes="btn-primary" Content="{Binding ApplyDaemonLabel}" Command="{Binding SaveDaemonSessionCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding TabInterface}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Margin="16" HorizontalAlignment="Stretch">
              <Border Classes="settings-panel" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section-title" Text="{Binding AppearanceTitle}" />
                  <TextBlock Classes="field-section" Text="{Binding ThemeSectionLabel}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="option-chip" Classes.selected="{Binding IsAppearanceLight}" Content="{Binding AppearanceLightLabel}" Command="{Binding SelectAppearanceCommand}" CommandParameter="light" />
                    <Button Classes="option-chip" Classes.selected="{Binding IsAppearanceDark}" Content="{Binding AppearanceDarkLabel}" Command="{Binding SelectAppearanceCommand}" CommandParameter="dark" />
                    <Button Classes="option-chip" Classes.selected="{Binding IsAppearanceSystem}" Content="{Binding AppearanceSystemLabel}" Command="{Binding SelectAppearanceCommand}" CommandParameter="system" />
                  </StackPanel>

                  <TextBlock Classes="field-section" Text="{Binding ColorSchemeSectionLabel}" Margin="0,8,0,0" />
                  <ItemsControl ItemsSource="{Binding PaletteChips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PaletteChipViewModel">
                        <Button Classes="palette-chip"
                                Classes.selected="{Binding IsSelected}"
                                Margin="0,0,8,8"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).SelectColorSchemeCommand}"
                                CommandParameter="{Binding Id}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="18" Height="18"
                                     Fill="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="settings-panel" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section-title" Text="{Binding LanguageTitle}" />
                  <TextBlock Classes="field-label" Text="{Binding LanguageLabel}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="option-chip" Classes.selected="{Binding IsLanguageEnglish}" Content="{Binding LanguageEnglishLabel}" Command="{Binding SelectLanguageCommand}" CommandParameter="en" />
                    <Button Classes="option-chip" Classes.selected="{Binding IsLanguageRussian}" Content="{Binding LanguageRussianLabel}" Command="{Binding SelectLanguageCommand}" CommandParameter="ru" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="settings-panel" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section-title" Text="{Binding WindowTitle}" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Classes="field-label" Text="{Binding RefreshIntervalLabel}" />
                      <NumericUpDown Value="{Binding RefreshIntervalSeconds}" Minimum="1" Maximum="3600" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="field-label" Text="{Binding WindowWidthLabel}" />
                      <NumericUpDown Value="{Binding WindowWidth}" Minimum="640" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="field-label" Text="{Binding WindowHeightLabel}" />
                      <NumericUpDown Value="{Binding WindowHeight}" Minimum="480" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="text-muted" Text="{Binding WindowHint}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="settings-panel" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-title" Text="{Binding TrayTitle}" />
                  <CheckBox Content="{Binding TrayEnabledLabel}" IsChecked="{Binding TrayEnabled}" IsEnabled="{Binding TraySupported}" />
                  <CheckBox Content="{Binding TrayCloseLabel}" IsChecked="{Binding CloseToTray}" IsEnabled="{Binding TraySupported}" />
                  <CheckBox Content="{Binding TrayMinimizeLabel}" IsChecked="{Binding MinimizeToTray}" IsEnabled="{Binding TraySupported}" />
                </StackPanel>
              </Border>

              <Border Classes="settings-panel" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-title" Text="{Binding TorrentAssociationTitle}" />
                  <Button Classes="btn-ghost" Content="{Binding RegisterAssociationLabel}" Command="{Binding RegisterTorrentAssociationCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>
  </DockPanel>
</UserControl>
