<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransmissonNET.Providers.LostFilm.LostFilmLoginWindow"
        Title="LostFilm login"
        Width="440"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="LostFilm" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="Sign in with email/password, or paste lf_session cookie."
               Opacity="0.7"
               TextWrapping="Wrap" />
    <TextBox x:Name="EmailBox" PlaceholderText="Email" />
    <TextBox x:Name="PasswordBox" PlaceholderText="Password" PasswordChar="•" />
    <TextBlock Text="Or session cookie" Opacity="0.7" />
    <TextBox x:Name="CookieBox" PlaceholderText="lf_session value" />
    <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="OrangeRed" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancelClick" />
      <Button Content="Login" Click="OnLoginClick" />
    </StackPanel>
  </StackPanel>
</Window>
